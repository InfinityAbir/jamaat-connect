# Database Configuration
POSTGRES_DB=jamaat_connect_dev
POSTGRES_USER=jamaat_user
POSTGRES_PASSWORD=jamaat_dev_password

# Backend Configuration
ASPNETCORE_ENVIRONMENT=Development
CONNECTION_STRINGS__DEFAULTCONNECTION=Host=db;Database=jamaat_connect_dev;Username=jamaat_user;Password=jamaat_dev_password

# SMTP Email Configuration (update with real credentials when available)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_SENDER_EMAIL=noreply@jamaatconnect.example.com
SMTP_SENDER_NAME=Jamaat Connect
SMTP_ENABLE_SSL=true
